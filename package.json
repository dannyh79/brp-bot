{
  "name": "brp-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier -w --log-level warn",
    "format:all": "prettier -w --log-level warn .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:create": "wrangler d1 migrations create DB",
    "db:seed": "wrangler d1 execute DB --local --file='./worker/d1/seed.sql'",
    "db:write": "node --experimental-strip-types scripts/writeToD1FromGoogleSheets.mts",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "cf-typegen": "wrangler types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.3",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.6.1",
    "@line/bot-sdk": "^11.2.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^176.0.0",
    "hono": "^4.13.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
