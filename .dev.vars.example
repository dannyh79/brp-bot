# Optional LINE delivery: leave both blank to disable.
LINE_ADMIN_RECIPIENT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
API_TOKEN=some-very-secretive-token

# Scheduled channel toggles: use exactly true or false; unset defaults to false.
LINE_ENABLED=false
TELEGRAM_ENABLED=false

# Optional Telegram delivery: leave all three blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_ID=
